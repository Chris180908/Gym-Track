<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F1217">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:gravity="center_vertical">
        <ImageView android:layout_width="49dp"
            android:layout_height="49dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/gt_logo"
            android:padding="11dp"
            android:src="@drawable/ic_gym"
            android:tint="#E9EDF5"
            android:contentDescription="GymTrack" />
        <TextView style="@style/GtTitle"
            android:text="Bienvenido a GymTrack"
            android:textSize="27sp" />
        <TextView style="@style/GtBody"
            android:text="Ingresa para consultar tu perfil y tu membresía."
            android:layout_marginTop="5dp"
            android:layout_marginBottom="28dp" />
        <TextView style="@style/GtLabel"
            android:text="Correo electrónico" />
        <EditText style="@style/GtField"
            android:id="@+id/login_correo"
            android:hint="nombre@correo.com"
            android:inputType="textEmailAddress" />
        <TextView style="@style/GtLabel"
            android:text="Contraseña" />
        <EditText style="@style/GtField"
            android:id="@+id/login_contra"
            android:hint="••••••••"
            android:inputType="textPassword" />
        <CheckBox android:id="@+id/login_remember"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mantener iniciada la cuenta"
            android:textColor="#E9EDF5"
            android:textSize="14sp"
            android:buttonTint="#2E68F7"
            android:layout_marginBottom="12dp" />
        <TextView style="@style/GtBody"
            android:id="@+id/login_error"
            android:textColor="#F5C36A"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            tools:text="Mensaje de error" />
        <Button style="@style/GtPrimary"
            android:id="@+id/btn_ingresar"
            android:text="Ingresar" />
        <TextView style="@style/GtLabel"
            android:text="¿No tienes acceso? Acude a recepción."
            android:gravity="center"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>
