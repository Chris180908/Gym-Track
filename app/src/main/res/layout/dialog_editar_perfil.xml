<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F1217">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:gravity="top">
        <TextView style="@style/GtLabel"
            android:text="Nombre" />
        <EditText style="@style/GtField"
            android:id="@+id/editar_nombre"
            android:hint=""
            android:inputType="textCapWords" />
        <TextView style="@style/GtLabel"
            android:text="Correo electrónico" />
        <EditText style="@style/GtField"
            android:id="@+id/editar_correo"
            android:hint=""
            android:inputType="textEmailAddress" />
        <TextView style="@style/GtLabel"
            android:text="Teléfono" />
        <EditText style="@style/GtField"
            android:id="@+id/editar_tel"
            android:hint=""
            android:inputType="phone" />
        <TextView style="@style/GtBody"
            android:id="@+id/editar_error"
            android:textColor="#F5C36A" />
    </LinearLayout>
</ScrollView>
