<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F1217">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:gravity="top">
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <TextView style="@style/GtTitle"
                android:text="Mi perfil"
                android:layout_width="0dp"
                android:layout_weight="1" />
            <ImageButton android:id="@+id/btn_refresh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                android:tint="#9AA7B8"
                android:contentDescription="Actualizar" />
        </LinearLayout>
        <TextView style="@style/GtTitle"
            android:id="@+id/perfil_avatar"
            android:gravity="center"
            android:layout_width="94dp"
            android:layout_height="94dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/gt_avatar"
            android:textSize="32sp"
            tools:text="CM" />
        <TextView style="@style/GtTitle"
            android:id="@+id/perfil_nombre"
            android:gravity="center"
            android:textSize="21sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            tools:text="Carlos Mendoza" />
        <TextView style="@style/GtPill"
            android:id="@+id/perfil_estado"
            tools:text="Socio activo" />
        <LinearLayout style="@style/GtCard"
            android:layout_marginTop="26dp">
            <TextView style="@style/GtLabel"
                android:text="ID de socio" />
            <TextView style="@style/GtValue"
                android:id="@+id/perfil_id"
                tools:text="1024" />
            <View style="@style/GtDivider" />
            <TextView style="@style/GtLabel"
                android:text="Teléfono" />
            <TextView style="@style/GtValue"
                android:id="@+id/perfil_tel"
                tools:text="55 2145 8890" />
            <View style="@style/GtDivider" />
            <TextView style="@style/GtLabel"
                android:text="Correo" />
            <TextView style="@style/GtValue"
                android:id="@+id/perfil_correo"
                tools:text="nombre@correo.com" />
            <View style="@style/GtDivider" />
            <TextView style="@style/GtLabel"
                android:text="Primera membresía" />
            <TextView style="@style/GtValue"
                android:id="@+id/perfil_primera"
                tools:text="18 de noviembre de 2026" />
        </LinearLayout>
        <Button style="@style/GtButton"
            android:id="@+id/btn_editar"
            android:text="Editar mis datos"
            android:layout_marginTop="16dp" />
        <Button style="@style/GtButton"
            android:id="@+id/btn_logout"
            android:text="Cerrar sesión"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
